# Copy this file to .env and fill in real values locally / in CI secrets.
# Never commit .env — it is already listed in .gitignore.

WORKFLOWPRO_BASE_URL=https://app.workflowpro.com
WORKFLOWPRO_API_URL=https://api.workflowpro.com

# Seeded test accounts — see data/test_users.example.json for the shape.
COMPANY1_ADMIN_EMAIL=
COMPANY1_ADMIN_PASSWORD=
COMPANY2_USER_EMAIL=
COMPANY2_USER_PASSWORD=

# Static per-tenant API bearer tokens (see docs/testing-approach.md for the
# assumption this makes about how auth works).
COMPANY1_API_TOKEN=
COMPANY2_API_TOKEN=

# Seeded/static OTP for accounts where requires_2fa is true.
TEST_OTP_CODE=

# BrowserStack (required only for tests/mobile and the mobile method in
# tests/integration — run `pytest -m "not mobile"` to skip them without these).
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
